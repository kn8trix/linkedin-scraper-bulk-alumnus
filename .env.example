# Copy to .env and fill in. .env is gitignored -- never commit real values.
#
# Get BOTH values from the SAME request, so they are guaranteed to match:
#   DevTools -> Network -> click any linkedin.com request -> Request Headers
#   -> copy the `cookie:` value and the `user-agent:` value

# REQUIRED. The whole cookie header, on ONE line (it wraps when pasted -- rejoin
# it). Carries bcookie/bscookie/lidc/liap alongside li_at, so requests look like
# a real browser's. JSESSIONID is parsed out of it for the csrf-token header.
LI_COOKIE=bcookie="v=2&..."; li_at=AQEDA...; JSESSIONID="ajax:123..."; lidc="b=..."

# REQUIRED, and there is no default. LinkedIn binds a session to the User-Agent
# that created it: the same li_at sent under a different UA reads as a stolen
# session and is revoked server-side, usually within minutes. A guessed UA would
# destroy the cookie you just pasted, so probe.py refuses to run without this.
LI_USER_AGENT=

# FALLBACK, used only when LI_COOKIE is unset. Both must come from the SAME
# browser session -- a fresh li_at with a stale JSESSIONID gives HTTP 403.
# LI_AT=AQEDA...
# LI_JSESSIONID=ajax:1234567890123456789

# Optional. Pins the decorationId version instead of probing for it.
# probe.py caches whichever version works in out/.decoration by itself.
# LI_DECORATION_VERSION=96
