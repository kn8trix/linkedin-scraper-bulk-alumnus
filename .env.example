# Copy to .env and fill in. .env is gitignored -- never commit real values.
#
# Get BOTH values from the SAME request, so they are guaranteed to match:
#   DevTools -> Network -> click any linkedin.com request -> Request Headers
#   -> copy the `cookie:` value and the `user-agent:` value

# REQUIRED. The whole cookie header, on ONE line (it wraps when pasted -- rejoin
# it). Carries bcookie/bscookie/lidc/liap alongside li_at, so requests look like
# a real browser's. JSESSIONID is parsed out of it for the csrf-token header.
LI_COOKIE=bcookie="v=2&..."; li_at=AQEDA...; JSESSIONID="ajax:123..."; lidc="b=..."

# REQUIRED, and there is no default. LinkedIn binds a session to the User-Agent
# that created it: the same li_at sent under a different UA reads as a stolen
# session and is revoked server-side, usually within minutes. A guessed UA would
# destroy the cookie you just pasted, so probe.py refuses to run without this.
LI_USER_AGENT=

# FALLBACK, used only when LI_COOKIE is unset. Both must come from the SAME
# browser session -- a fresh li_at with a stale JSESSIONID gives HTTP 403.
# LI_AT=AQEDA...
# LI_JSESSIONID=ajax:1234567890123456789

# Optional. Pins the decorationId version instead of probing for it.
# probe.py caches whichever version works in out/.decoration by itself.
# LI_DECORATION_VERSION=96

# --- bulk scraping (/api/bulk-scrape) --------------------------------------
# Bulk calls are the easiest way to get a session revoked, so URLs are spaced
# with a random delay, widened by exponential back-off when LinkedIn throttles.

# Random gap between profiles, in seconds.
# BULK_DELAY_MIN_SECONDS=1.0
# BULK_DELAY_MAX_SECONDS=3.0

# Throttle back-off: each consecutive 429 multiplies the next gap by this,
# capped at BULK_MAX_BACKOFF_SECONDS. The batch aborts after
# BULK_MAX_CONSECUTIVE_THROTTLES in a row instead of hammering LinkedIn.
# BULK_BACKOFF_FACTOR=2.0
# BULK_MAX_BACKOFF_SECONDS=30
# BULK_MAX_CONSECUTIVE_THROTTLES=3

# Batch limits.
# MAX_BULK_URLS=50
# MAX_UPLOAD_BYTES=2097152
# IMAGE_TIMEOUT_SECONDS=20

# --- keep-alive (Render free tier) -----------------------------------------
# A Free web service spins down after 15 minutes WITHOUT INBOUND TRAFFIC. A
# request to our own loopback interface never crosses Render's edge and is NOT
# counted, so the ping must go to the public URL and re-enter from outside.
# Render injects RENDER_EXTERNAL_URL automatically -- that is what enables the
# loop in production. Nothing to do on Render.

# Set to 1 to run the loop locally against http://127.0.0.1:$PORT/health/live.
# Leave unset in production: RENDER_EXTERNAL_URL is enough.
# KEEPALIVE_ENABLED=1

# Ping cadence. 10 minutes sits comfortably inside Render's 15-minute window.
# KEEPALIVE_INTERVAL_SECONDS=600
# KEEPALIVE_INITIAL_DELAY_SECONDS=10
# KEEPALIVE_TIMEOUT_SECONDS=10

# Override the target entirely (defaults to $RENDER_EXTERNAL_URL/health/live).
# Point this at /health/live, NOT /health -- /health answers 503 when the
# LinkedIn session is dead and would look like a failed keep-alive.
# KEEPALIVE_URL=https://your-app.onrender.com/health/live
